# ─── Uygulama ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=ArtVista OS
NEXT_PUBLIC_APP_VERSION=1.0.0

# ─── Veritabanı (Turso) ──────────────────────────────────────────────────────
# Boş bırakılırsa lokal artvista.db dosyası kullanılır.
# turso db show artvista --url        → URL
# turso db tokens create artvista     → token
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── Giriş (Auth.js + Google) ────────────────────────────────────────────────
# AUTH_GOOGLE_ID boş bırakılırsa giriş sistemi devre dışı kalır (lokal geliştirme).
# npx auth secret → AUTH_SECRET üretir
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Virgülle ayrılmış izinli e-postalar
ALLOWED_EMAILS=

# Vercel'de otomatik gelir; lokalde gerekmez
# AUTH_URL=https://panel.artvista.com
